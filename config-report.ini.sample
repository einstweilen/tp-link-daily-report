[Router]
# IP des TP-Link Routers
# passwort ist das Passwort der Router-Admin-Oberfläche
router_ip        = 192.168.0.1
password         = DAS_ROUTER_PASSWORT

[Database]
# SQLite Datenbank kompatibel zu vx-info.py
# Beide Skripte können dieselbe Datenbank nutzen
# dazu in beiden configs den gleichen Pfad angeben
db_name          = router_data.db

[Email]
# SMTP Server und Zugangsdaten des Providers
# man kann sich einen eigenen Account nur für das Reportversenden und -empfangen einrichten
# dann sind die Zugangsdaten völlig unabhängig vom Haupt-E-Mail-Account
smtp_server      = smtp.example.com
smtp_port        = 587
sender_email     = ABSENDER_EMAIL@example.com
sender_password  = DAS_EMAIL_PASSWORT
recipient_email  = EMPFAENGER_EMAIL@example.com

[Modul]
# True das Modul ist aktiviert / False das Modul ist deaktiviert
ai_analysis      = True
# Client-Erfassung beim --update/Report (False = schneller Lauf: keine Clientabfrage,
# kein Aufwecken des Netzplans, kein ARP-Scan). Sinnvoll, wenn ein anderer Lauf
# (z.B. vx-info.py) dieselbe Datenbank stündlich mit Clientdaten füllt.
# Der Report-Header (Firmware/Uptime) wird weiterhin aktualisiert.
collect_clients  = True
reconnects       = True
line_analysis    = True
downstream_chart = True
client_presence  = True
presence         = True
snr_heatmap      = True
event_log        = True

[WebUI]
# Benutzername der Router-Weboberfläche (meist 'admin')
user = admin
# Die Firmware ab 09/2026 füllt DSL-/Client-Tabellen erst, wenn die Weboberfläche sie
# angefragt hat (die JSON-API liefert sonst dauerhaft leer). Bei leeren DSL-Daten wird
# die Weboberfläche deshalb einmal per Headless-Browser geöffnet:
#   auto = nur bei leeren Daten aufwecken (Standard) | aus = nie
warmup = auto
# Die DSL-Fehlerzähler (UCRC/DCRC) gibt es nur in der Weboberfläche:
#   gui = per Browser nachlesen (Standard, braucht playwright) | aus = nicht lesen
crc_source = gui

[AI]
# diese Daten werden vom Setupskript eingetragen
ai_provider = gemini
ai_api_key  = DEIN_GEMINI_API_KEY

[Analyse]
# regelbasierte Analyse der Routerevent-Logs
report_disconnects_level = 1

[Charts]
# Verlaufsdiagramm erfaßter DSL-Daten
# die Feldnamen kann man im Skript unter
# class DatabaseManager => def _create_tables einsehen
hours_back       = 48
start_hour       = 0
table_1          = dsl
field_1          = downstream_noise_margin
label_1          = SNR Downstream (dB)
moving_average_days = 7

[Events]
# Zeitraum für das Routereventlog und die AI Analyse
# Zeitraum der Events in Stunden gemessen vom Zeitpunkt der Reportgenerierung
hours_back = 24
# Startstunde der Events (0 = Mitternacht)
start_hour = 0

# Ausgeschlossene Event-Typen für das Log und die Analyse
# Zusatztypen, die nicht in der Ereignisliste erscheinen (Clientereignisse
# filtert das Programm selbst). Alte Namen wirken weiter: VoIP blendet auch
# voip_client aus.
exclude_types = VoIP

# Eigene Abrufe und Routine aus der Ereignisliste ausblenden:
#   - Zugriffe von der eigenen IP (httpd/cloud_https)
#   - tmpd ("Logout all users.") und die httpd-Erfolgsmeldungen
#   - An-/Abmeldungen der WLAN-Clients (mapAgent/mapController)
# Fehlermeldungen bleiben sichtbar (z. B. "Login failed!", "Connection Fail ...").
hide_own_activity = True
# Eigene IP-Adressen fuer die Erkennung eigener Abrufe (Komma-getrennt).
# Leer = automatisch ermitteln (Adresse dieses Rechners im Router-Netz).
own_ips =

# Log Level Filter: 0 Notfall   1 Alarm    2 Kritisch  3 Fehler 
#                   4 Vorsicht  5 Hinweis  6 Info      7 Debug (zeigt alles)
#                   9 zeigt alles wie 7 Debug aber filtert die 'exclude_types' aus
# bis einschließlich dieses Levels anzeigen
show_level = 4

# Tage bis alte Events vom Typ 'exclude_types' aus der Datenbank gelöscht werden
cleanup_excludes = 3

[Reports]
# Alte Tagesreports löschen (0 = deaktiviert)
cleanup_reports  = 7

[Language]
# Ausgabesprache des Tagesreports
# de = Deutsch, en = Englisch
lang = de 
